<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Foca.Plugins</RootNamespace>
    <!-- Published so third parties can build plugins against the contract only -->
    <PackageId>Foca.Plugins.Abstractions</PackageId>
    <Version>2.0.0</Version>
    <Description>Contract for FOCA plugins (API v2): UI-framework neutral commands, panels and analyzers.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foca.Core\Foca.Core.csproj" />
  </ItemGroup>

</Project>
