<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 keeps the WinForms application working; net10.0 runs on Windows, Linux and macOS -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>MetadataExtractCore</RootNamespace>
    <AssemblyName>MetadataExtractCore</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);PRO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.IO.Packaging" Version="9.0.0" />
  </ItemGroup>

</Project>
