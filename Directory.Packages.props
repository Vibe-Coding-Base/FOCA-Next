<Project>
  <!-- Central package versions (https://learn.microsoft.com/nuget/consume-packages/central-package-management) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Document extraction and search">
    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />
    <PackageVersion Include="PDFsharp" Version="6.1.1" />
    <PackageVersion Include="System.IO.Packaging" Version="10.0.13" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Google.Apis.Customsearch.v1" Version="1.43.0.1369" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <!-- DPAPI on Windows; the API throws PlatformNotSupported elsewhere (guarded in SecretProtector) -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- Patched transitive dependency of Microsoft.Data.SqlClient (GHSA-846f-f764-76mx) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Applications">
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!-- DataGrid is versioned separately from Avalonia; 11.3.13 is its latest 11.x release -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>
</Project>
