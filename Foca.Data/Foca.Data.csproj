<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Foca.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Patched transitive dependency of Microsoft.Data.SqlClient (GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Design-time only (dotnet ef); build assets excluded so its MSBuild host does not ship with FOCA -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" IncludeAssets="runtime; native; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foca.Core\Foca.Core.csproj" />
  </ItemGroup>

</Project>
