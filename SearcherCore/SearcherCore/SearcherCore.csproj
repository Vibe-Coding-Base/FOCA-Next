<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 keeps the WinForms application working; net10.0 runs on Windows, Linux and macOS -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>SearcherCore</RootNamespace>
    <AssemblyName>SearcherCore</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- HttpWebRequest is obsolete on .NET 10 but still the shared implementation for net48 -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);PRO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Customsearch.v1" Version="1.43.0.1369" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>

</Project>
