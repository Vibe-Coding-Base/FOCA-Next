<Project Sdk="Microsoft.NET.Sdk">

  <!-- foca-cli: the FOCA Next engine from the command line. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not "foca": it would overwrite FOCA (the desktop app) on case-insensitive file systems -->
    <AssemblyName>foca-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foca.Core\Foca.Core.csproj" />
    <ProjectReference Include="..\Foca.Data\Foca.Data.csproj" />
  </ItemGroup>

</Project>
