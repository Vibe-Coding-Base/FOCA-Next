<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project storage: SQLite by default, SQL Server optional; import from FOCA Classic. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Design-time only (dotnet ef); build assets excluded so its MSBuild host does not ship -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; native; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foca.Core\Foca.Core.csproj" />
  </ItemGroup>

</Project>
