<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Foca.Cli</RootNamespace>
    <!-- Not "foca": it would overwrite FOCA (the desktop app) on case-insensitive file systems -->
    <AssemblyName>foca-cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foca.Core\Foca.Core.csproj" />
    <ProjectReference Include="..\Foca.Data\Foca.Data.csproj" />
  </ItemGroup>

</Project>
