<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 runs everywhere; net48 also regenerates the corpus (System.Drawing) and guards the WinForms build -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net48;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="Fixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MetadataExtractCore\MetadataExtractCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Snapshots\**\*.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
