<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin API v1 used by FOCA Classic plugins (WinForms). Built from source instead of the binary that used to ship. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PluginsAPI</RootNamespace>
    <AssemblyName>PluginsAPI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
